# ===================================================================
# QuantPilot — Environment Configuration Template
# ===================================================================
# This is a template file for local environment configuration.
# Copy this file to '.env' and provide your actual local credentials.
# NEVER commit the '.env' file or any real credentials to Git.
#
# Rule: Real credentials are never required for default startup or unit tests.
# Only components invoked at runtime will validate their required keys.
# ===================================================================

# Core Application Settings
ENVIRONMENT=development
LIVE_TRADING_ENABLED=false
LOG_LEVEL=INFO
HISTORICAL_DATA_PATH=./data/historical

# AI / Claude Settings (validated only when Claude integration is invoked)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Broker Settings (validated only when broker integration is invoked)
ZERODHA_API_KEY=your-zerodha-api-key-here
ZERODHA_API_SECRET=your-zerodha-api-secret-here
ZERODHA_ACCESS_TOKEN=your-zerodha-access-token-here

# Database & Cache (optional in local development and testing)
DATABASE_URL=postgresql://user:password@localhost:5432/quantpilot
REDIS_URL=redis://localhost:6379/0

# Alerting & Webhooks (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
WEBHOOK_SECRET=your-webhook-secret-here
