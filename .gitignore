# ===================================================================
# QuantPilot .gitignore — Public Repository Security Controls
# ===================================================================

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
private/
.local/

# Data, database, and model binaries (Never commit real trading or account data)
*.db
*.sqlite
*.sqlite3
*.csv
*.parquet
*.pkl
*.joblib
*.h5
*.onnx
data/
storage/

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, coverage, and linting caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# IDEs, editors, and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs and outputs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
